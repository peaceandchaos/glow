<resources>
     <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
          <!-- Customize your theme here. -->
          <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
          <!-- Android 12+ shows a system splash on cold start whose background
               defaults to the (unset, light) windowBackground, flashing white on
               the slow first launch. Paint it black to match the app's #000 content.
               Ignored below API 31, which has no mandatory system splash. -->
          <item name="android:windowSplashScreenBackground">@android:color/black</item>
          <!-- The Activity window itself, shown in the hand-off after the splash
               dismisses but before RN paints its first frame. Black here closes the
               remaining white flash in that gap. -->
          <item name="android:windowBackground">@android:color/black</item>
     </style>

     <style name="BootTheme" parent="Theme.BootSplash">
          <item name="bootSplashBackground">@color/bootsplash_background</item>
          <item name="bootSplashLogo">@drawable/bootsplash_logo</item>
          <item name="postBootSplashTheme">@style/AppTheme</item>
     </style>
</resources>
