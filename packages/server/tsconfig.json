{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["node_modules", ".nitro", ".output", ".vercel"]
}
