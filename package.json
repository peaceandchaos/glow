{
  "name": "personal-ai-chat",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/app",
    "packages/server"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings --disable-nested-config .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:app": "oxfmt --write packages/app",
    "secrets": "node tools/check-credentials.cjs",
    "secrets:staged": "node tools/check-credentials.cjs --staged",
    "security": "node tools/security-check.cjs",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:range": "node tools/range-typecheck.cjs",
    "exports:check": "node tools/exports-check.cjs",
    "test": "jest --config tools/jest.config.cjs --runInBand && npm run test --workspaces --if-present -- --runInBand",
    "test:verified": "node tools/test-verified.cjs",
    "audit:check": "node tools/audit-check.cjs",
    "build:server": "npm run build --workspace packages/server",
    "build:ios-js": "node tools/build-ios-js.cjs",
    "verify:staged": "node tools/verify.cjs staged",
    "verify:commit": "node tools/verify.cjs commit",
    "verify:current": "node tools/verify.cjs current",
    "skills:required": "node tools/skills/cli.cjs required",
    "skills:catalog": "node tools/skills/cli.cjs catalog",
    "skills:record": "node tools/skills/cli.cjs record",
    "skills:check": "node tools/skills/cli.cjs check",
    "skills:ledger": "node tools/skills/cli.cjs ledger",
    "skills:doctor": "node tools/skills/cli.cjs doctor",
    "react-compiler-check": "npm run react-compiler-check --workspace packages/app",
    "start": "npm run start --workspace packages/app",
    "ios": "npm run ios --workspace packages/app",
    "android": "npm run android --workspace packages/app",
    "postinstall": "patch-package --error-on-fail --patch-dir packages/app/patches",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/plugin-transform-typescript": "7.29.7",
    "@oxlint/plugins": "1.86.0",
    "@types/jest": "^29.5.13",
    "babel-jest": "29.7.0",
    "husky": "9.1.7",
    "jest": "^29.6.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "rnsec": "1.3.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.23.3"
  },
  "overrides": {
    "@react-native-community/cli-config": {
      "joi": "17.13.8"
    },
    "@react-native-community/cli-types": {
      "joi": "17.13.8"
    },
    "metro": {
      "image-size": "2.0.3"
    },
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.1"
    },
    "@workflow/world-vercel": {
      "undici": "7.29.1"
    },
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "@babel/helper-compilation-targets": {
      "browserslist": "4.28.7"
    },
    "core-js-compat": {
      "browserslist": "4.28.7"
    },
    "zeego": {
      "@react-native-menu/menu": "^2.0.0",
      "react-native-ios-context-menu": "^3.2.1",
      "react-native-ios-utilities": "^5.2.0"
    },
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
